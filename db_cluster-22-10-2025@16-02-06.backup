--
-- Name: bill_members Delete own bill_members; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Delete own bill_members" ON public.bill_members FOR DELETE USING ((auth.uid() IN ( SELECT bills.owner_id
   FROM public.bills
  WHERE (bills.id = bill_members.bill_id))));


--
-- Name: bills Delete own bills; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Delete own bills" ON public.bills FOR DELETE USING ((auth.uid() = owner_id));


--
-- Name: categories Delete own categories; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Delete own categories" ON public.categories FOR DELETE USING ((user_id = auth.uid()));


--
-- Name: transactions Delete own transactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Delete own transactions" ON public.transactions FOR DELETE USING ((user_id = auth.uid()));


--
-- Name: bill_members Insert as member; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Insert as member" ON public.bill_members FOR INSERT WITH CHECK ((auth.uid() IN ( SELECT bills.owner_id
   FROM public.bills
  WHERE (bills.id = bill_members.bill_id))));


--
-- Name: ai_logs Insert own ai_logs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Insert own ai_logs" ON public.ai_logs FOR INSERT WITH CHECK ((user_id = auth.uid()));


--
-- Name: bills Insert own bills; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Insert own bills" ON public.bills FOR INSERT WITH CHECK ((auth.uid() = owner_id));


--
-- Name: categories Insert own categories; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Insert own categories" ON public.categories FOR INSERT WITH CHECK ((user_id = auth.uid()));


--
-- Name: transactions Insert own transactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Insert own transactions" ON public.transactions FOR INSERT WITH CHECK ((user_id = auth.uid()));


--
-- Name: ai_logs Select own ai_logs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Select own ai_logs" ON public.ai_logs FOR SELECT USING ((user_id = auth.uid()));


--
-- Name: bill_members Select own bill_members; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Select own bill_members" ON public.bill_members FOR SELECT USING (((auth.uid() = user_id) OR (auth.uid() IN ( SELECT bills.owner_id
   FROM public.bills
  WHERE (bills.id = bill_members.bill_id)))));


--
-- Name: bills Select own bills; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Select own bills" ON public.bills FOR SELECT USING ((auth.role() = 'authenticated'::text));


--
-- Name: categories Select own categories; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Select own categories" ON public.categories FOR SELECT USING ((auth.role() = 'authenticated'::text));


--
-- Name: transactions Select own transactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Select own transactions" ON public.transactions FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.bills
  WHERE ((bills.id = transactions.bill_id) AND ((bills.owner_id = auth.uid()) OR (EXISTS ( SELECT 1
           FROM public.bill_members
          WHERE ((bill_members.bill_id = bills.id) AND (bill_members.user_id = auth.uid())))))))));


--
-- Name: bill_members Update own bill_members; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Update own bill_members" ON public.bill_members FOR UPDATE USING ((auth.uid() IN ( SELECT bills.owner_id
   FROM public.bills
  WHERE (bills.id = bill_members.bill_id))));


--
-- Name: bills Update own bills; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Update own bills" ON public.bills FOR UPDATE USING ((auth.uid() = owner_id));


--
-- Name: categories Update own categories; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Update own categories" ON public.categories FOR UPDATE USING ((EXISTS ( SELECT 1
   FROM public.bills
  WHERE ((bills.id = categories.bill_id) AND (bills.owner_id = auth.uid())))));


--
-- Name: transactions Update own transactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Update own transactions" ON public.transactions FOR UPDATE USING ((user_id = auth.uid()));


