--
-- Name: public_user_profiles 认证用户可以查看公开用户信息; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "认证用户可以查看公开用户信息" ON public.public_user_profiles FOR SELECT USING ((auth.role() = 'authenticated'::text));


