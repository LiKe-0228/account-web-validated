    CONSTRAINT categories_type_check CHECK ((type = ANY (ARRAY['income'::text, 'expense'::text])))
);


ALTER TABLE public.categories OWNER TO postgres;

--
-- Name: public_user_profiles; Type: TABLE; Schema: public; Owner: postgres
